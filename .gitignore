# binaries
/funcbox
/funcbox-server
/bin/

# dashboard build output (generated by `make server`; see tmp/09-dashboard.md
# §9.2's deviation note: dist/ lives under internal/dashboard, not
# dashboard/, because go:embed can't reach outside its own package
# directory). dist/.gitkeep itself IS tracked (a placeholder go:embed needs
# to see before the first build; a directory-level ignore would also hide
# the negated .gitkeep, since git can't re-include a file inside an excluded
# directory -- so this ignores dist's *contents* instead).
/internal/dashboard/dist/*
!/internal/dashboard/dist/.gitkeep
/dashboard/node_modules/

# local dev
.env
.env.*
*.db
*.sqlite

# OS
.DS_Store

# local design documents (kept out of the repository entirely)
/tmp/
