{
  "name": "vinext",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.5",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.2.1",
    "wrangler": "^4.122.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/build-assets.mjs",
    "start:cloudflare": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cloudflare": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "funcbox:dev": "go run ../../cmd/funcbox dev ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
