# actual fetch-handler worker) and the generated asset map
# (dist/assets.js) need to deploy, plus funcbox-entry.js/funcbox.yaml.
# Everything else here is source, tooling, or the raw dist/client copy
# that dist/assets.js already embeds — see README.md for the full
# architecture and scripts/build-assets.mjs for how dist/assets.js is
# generated.

app/
scripts/
dist/client/
.next/
.wrangler/

# compat.nodejs is enabled (dist/server/index.js statically imports
# node:async_hooks), which would otherwise pull node_modules/ into the
# bundle too -- but dist/server/index.js is already vinext's fully
# self-contained Cloudflare Workers build (esbuild-bundled by vinext
# itself); the only thing left unresolved is the node:async_hooks import,
# which funcbox's own compat.nodejs resolves directly (a core-module
# import, not a node_modules walk). node_modules/ is ~500 MiB here and
# genuinely not needed at runtime.
node_modules/

